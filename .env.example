# Anthropic API key (required) — powers interviews, analysis, literature, and writing
ANTHROPIC_API_KEY=sk-ant-...

# Flask session secret (set a random string in production)
SECRET_KEY=change-me

# Optional: override where the SQLite database lives (default: ./data)
# NBU_DATA_DIR=/app/data

# --- Microsoft Entra ID SSO (researcher login) ---------------------------------
# Leave unset for local development: auth is then DISABLED and the app runs as
# a synthetic dev user. All four are required in production.
# Setup steps: docs/ENTRA_SETUP.md
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_REDIRECT_URI=https://<your-app>.azurewebsites.net/auth/callback

# --- LSEG / Refinitiv connector (optional) -----------------------------------
# Leave unset to keep the Refinitiv module dormant. See docs/REFINITIV_DESIGN.md.
# Desktop mode (runs where Refinitiv Workspace is installed, e.g. your Mac):
#   LSEG_SESSION=desktop
#   LSEG_APP_KEY=<desktop app key generated in Workspace>
# Platform mode (Azure server, needs a machine account from LSEG):
#   LSEG_SESSION=platform
#   LSEG_APP_KEY=<app key>
#   LSEG_CLIENT_ID=<machine account client id>
#   LSEG_CLIENT_SECRET=<machine account client secret>

# --- Durable task queue (Celery + Redis) ---------------------------------------
# With CELERY_BROKER_URL set, background pipelines run in a separate worker
# process (start with: celery -A nbu_research.worker worker) and survive web
# restarts. Leave unset for the single-process dev flow (in-process threads).
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# USE_EAGER_TASKS=true   # dev: run tasks inline without Redis/worker
