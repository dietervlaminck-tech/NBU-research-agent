# Copy to .deploy.env (gitignored) and fill in. Used by ./deploy.sh and,
# optionally, as the reference for the GitHub Actions secrets.

# Azure resource names (reuse the same ones as your AI Interviewer deployment)
RESOURCE_GROUP=
APP_PLAN=
APP_NAME=nbu-research-agent
ACR_NAME=
STORAGE_ACCOUNT=

# Azure Files share name for the SQLite database (created if missing)
FILE_SHARE=nbu-research-data

# Application secrets (pushed to Azure app settings, never committed)
ANTHROPIC_API_KEY=sk-ant-...
SECRET_KEY=
